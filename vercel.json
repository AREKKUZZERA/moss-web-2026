{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/table/:path*",
      "destination": "/api/table?path=:path*"
    },
    {
      "source": "/api/moss/:path*",
      "destination": "/moss?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
